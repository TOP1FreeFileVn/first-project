# Godot 4+ specific ignores
.godot/
/android/

# Build outputs
/Build/
/output/

# OS junk
.DS_Store
Thumbs.db

# Local secrets / logs / backups
.env
debug.log
*.godot-mcp-backup-*
docs/design/**/*.log
docs/ui_review/**/*.log

# Reference screenshots of commercial games (copyright) - kept local only
docs/asset_reference/
# Same local-only policy for commercial art studies; keep notes and source IDs.
docs/design/2026-10-19/weapon-redesign/reference-study/**/*.png
docs/design/2026-10-19/weapon-redesign/reference-study/**/*.png.import
docs/design/2026-10-20/stroke-reference-study/*.png
docs/design/2026-10-20/stroke-reference-study/*.png.import
docs/design/2026-10-20/cat-shooter-background-study/cat-gunner-background-sources.png*
docs/design/2026-10-21/menu-frame-proposal/cat-gunner-frame-sources.png*
docs/design/2026-10-21/menu-frame-proposal/cat-gunner-official-merge-upgrade.webp*
# Godot editor profiles/caches captured by review tools
docs/**/Godot/

# Python runtime caches
__pycache__/
*.py[cod]
