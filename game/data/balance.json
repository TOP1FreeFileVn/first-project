{
	"version": 1,
	"formulas": {
		"level_cost": {
			"label": "Giá lên cấp lính (vàng)",
			"used_in": "Lính → Nâng cấp",
			"expr": "round(50 * pow(1.35, level - 1))",
			"vars": ["level"],
			"preview": {"x": "level", "from": 1, "to": 30, "step": 1},
			"min": 1
		},
		"troop_multiplier": {
			"label": "Hệ số sức mạnh lính theo cấp và sao",
			"used_in": "Máu và sát thương lính trong trận",
			"expr": "(1 + 0.08 * (level - 1)) * pow(1.12, stars - 1)",
			"vars": ["level", "stars"],
			"preview": {"x": "level", "from": 1, "to": 30, "step": 1, "series": "stars", "series_values": [1, 2, 3]},
			"min": 0.01
		},
		"tier_multiplier": {
			"label": "Hệ số theo bậc gear (ghép)",
			"used_in": "Máu và sát thương lính sinh ra từ gear",
			"expr": "pow(1.75, tier - 1)",
			"vars": ["tier"],
			"preview": {"x": "tier", "from": 1, "to": 5, "step": 1},
			"min": 0.01
		},
		"spawn_interval": {
			"label": "Thời gian gear sinh 1 lính (giây)",
			"used_in": "Gear trong trận",
			"expr": "base * pow(0.92, tier - 1) / (1 + master_bonus)",
			"vars": ["base", "tier", "master_bonus"],
			"preview": {"x": "tier", "from": 1, "to": 5, "step": 1, "samples": {"base": 4.5, "master_bonus": 0}},
			"min": 0.2
		},
		"round_income": {
			"label": "Thu nhập xu sau mỗi đợt",
			"used_in": "Hết đợt, trước lượt nghỉ; wave = đợt vừa xong (từ 1), bonus = Két xu",
			"expr": "5 + wave + bonus",
			"vars": ["wave", "bonus"],
			"preview": {"x": "wave", "from": 1, "to": 8, "step": 1, "series": "bonus", "series_values": [0, 2, 5]},
			"min": 0
		},
		"interest": {
			"label": "Lãi xu khi để dành",
			"used_in": "Hết đợt, tính trên số xu đang có trước khi cộng thu nhập",
			"expr": "min(floor(meat / 5), 3)",
			"vars": ["meat"],
			"preview": {"x": "meat", "from": 0, "to": 20, "step": 1},
			"min": 0
		},
		"enemy_multiplier": {
			"label": "Hệ số sức mạnh quân địch",
			"used_in": "Máu và sát thương địch; power = sức mạnh màn, wave = đợt (từ 0)",
			"expr": "power * (1 + 0.2 * wave)",
			"vars": ["power", "wave"],
			"preview": {"x": "wave", "from": 0, "to": 7, "step": 1, "series": "power", "series_values": [1, 2, 3]},
			"min": 0.01
		},
		"siege_damage": {
			"label": "Sát thương địch gây cho tường thành",
			"used_in": "Khi địch đánh vào tường; damage = sát thương của địch",
			"expr": "damage * 0.35",
			"vars": ["damage"],
			"preview": {"x": "damage", "from": 0, "to": 50, "step": 5},
			"min": 0
		},
		"workshop_cost": {
			"label": "Giá nâng cấp Xưởng (vàng)",
			"used_in": "Thành → Xưởng; base, growth lấy theo từng nâng cấp",
			"expr": "round(base * pow(growth, level))",
			"vars": ["base", "growth", "level"],
			"preview": {"x": "level", "from": 0, "to": 5, "step": 1, "samples": {"base": 120, "growth": 1.6}},
			"min": 1
		},
		"win_gold": {
			"label": "Vàng khi thắng màn",
			"used_in": "Bảng kết thúc trận; level = số thứ tự màn (từ 0)",
			"expr": "60 + 40 * (level + 1) + 20 * stars",
			"vars": ["level", "stars"],
			"preview": {"x": "level", "from": 0, "to": 9, "step": 1, "series": "stars", "series_values": [1, 2, 3]},
			"min": 0
		},
		"loss_gold": {
			"label": "Vàng khi thua màn",
